# Port exposed by the standalone workspace server
PORT=8080

# Optional: point the workspace at another Velclaw-compatible agent endpoint.
# Default: https://velclaw.cfd/api/agent/chat
VELCLAW_AGENT_URL=https://velclaw.cfd/api/agent/chat

# Optional bearer token for protected agent endpoints.
VELCLAW_AGENT_TOKEN=

# Optional filesystem root when running the workspace outside the repo.
WORKSPACE_ROOT=.
